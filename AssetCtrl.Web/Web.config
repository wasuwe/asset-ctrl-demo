<?xml version="1.0"?>
<configuration>
  <!-- Database connection lives in ConnectionStrings.config (git-ignored).
       Copy ConnectionStrings.config.example to ConnectionStrings.config and fill in your values
       (the build copies it for you when the file is missing). -->
  <connectionStrings configSource="ConnectionStrings.config"/>
  <appSettings>
    <add key="AppName" value="Asset Ctrl"/>
    <add key="OrgName" value="IT Section"/>
    <!-- Windows time zone id. "SE Asia Standard Time" = Asia/Bangkok (UTC+7). -->
    <add key="TimeZone" value="SE Asia Standard Time"/>
    <!-- true shows exception messages in API errors. Keep false in production. -->
    <add key="Debug" value="false"/>
    <add key="SessionIdleMinutes" value="240"/>
    <!-- Area given to a device when IT receives it into the repair room (Setting Room "Receive"). -->
    <add key="RepairArea" value="ICS-SETTING-ROOM"/>
    <!-- A device still in the repair room after this many days is listed under "Needs attention". -->
    <add key="RoomOverdueDays" value="3"/>
    <!-- When the database cannot be connected, the browser app switches to Demo mode
         (built-in sample data, a "Demo mode" banner, nothing is saved). false = show an error instead. -->
    <add key="DemoFallback" value="true"/>
    <!-- Largest file Import accepts, in MB. The browser uploads it in 1 MB parts, so maxRequestLength does not need raising. -->
    <add key="ImportMaxMb" value="200"/>
    <!-- Optional friendly names for asset-number prefixes, e.g. "PCD=PC Desktop;PCN=Notebook". -->
    <add key="AssetTypeLabels" value=""/>
  </appSettings>
  <system.web>
    <compilation debug="true" targetFramework="4.8"/>
    <httpRuntime targetFramework="4.8" maxRequestLength="20480" enableVersionHeader="false"/>
    <!-- The API uses its own session (app_sessions table); ASP.NET session state is not used. -->
    <sessionState mode="Off"/>
    <customErrors mode="RemoteOnly"/>
    <pages controlRenderingCompatibilityVersion="4.0"/>
  </system.web>
  <!-- Binding redirects for the NuGet dependencies of Npgsql on .NET Framework 4.8. -->
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Buffers" culture="neutral" publicKeyToken="cc7b13ffcd2ddd51"/>
        <bindingRedirect oldVersion="0.0.0.0-4.0.3.0" newVersion="4.0.3.0"/>
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Memory" culture="neutral" publicKeyToken="cc7b13ffcd2ddd51"/>
        <bindingRedirect oldVersion="0.0.0.0-4.0.1.1" newVersion="4.0.1.1"/>
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Runtime.CompilerServices.Unsafe" culture="neutral" publicKeyToken="b03f5f7f11d50a3a"/>
        <bindingRedirect oldVersion="0.0.0.0-4.0.5.0" newVersion="4.0.5.0"/>
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Threading.Tasks.Extensions" culture="neutral" publicKeyToken="cc7b13ffcd2ddd51"/>
        <bindingRedirect oldVersion="0.0.0.0-4.2.0.1" newVersion="4.2.0.1"/>
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.ValueTuple" culture="neutral" publicKeyToken="cc7b13ffcd2ddd51"/>
        <bindingRedirect oldVersion="0.0.0.0-4.0.3.0" newVersion="4.0.3.0"/>
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
  <system.webServer>
    <defaultDocument enabled="true">
      <files>
        <clear/>
        <add value="Default.aspx"/>
      </files>
    </defaultDocument>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="20971520"/>
        <hiddenSegments>
          <add segment="ConnectionStrings.config"/>
        </hiddenSegments>
      </requestFiltering>
    </security>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By"/>
        <add name="X-Frame-Options" value="SAMEORIGIN"/>
        <add name="Referrer-Policy" value="same-origin"/>
      </customHeaders>
    </httpProtocol>
    <staticContent>
      <remove fileExtension=".woff2"/>
      <mimeMap fileExtension=".woff2" mimeType="font/woff2"/>
    </staticContent>
  </system.webServer>
</configuration>