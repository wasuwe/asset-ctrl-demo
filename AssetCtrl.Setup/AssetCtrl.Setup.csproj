<Project Sdk="Microsoft.NET.Sdk">

  <!-- Setup tool: create / update the tables, create the first admin, load sample data. See Program.cs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <IsPackable>false</IsPackable>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- Same versions as AssetCtrl.Web -->
    <PackageReference Include="Npgsql" Version="4.1.14" />
    <PackageReference Include="Dapper" Version="2.0.151" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Configuration" />
    <Reference Include="System.Web" />
    <Reference Include="System.Xml.Linq" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AssetCtrl.Web\AssetCtrl.Web.csproj" />
    <!-- The schema travels inside the exe, so the tool works from any folder. -->
    <EmbeddedResource Include="..\AssetCtrl.Web\Database\schema.pg.sql" LogicalName="schema.pg.sql" />
  </ItemGroup>

</Project>
